@using BudgetTracker.Core.DTOs;
@model PagedResultDto<TagDto>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>
                Context
            </th>
            <th>
                Name
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td style="width: 40%;">
                    @Html.DisplayFor(modelItem => item.Context)
                </td>
                <td style="width: 40%;">
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td style="width: 20%;">
                    <button class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#editModal" data-id="@item.Id" title="Edit"><i class="bi bi-pencil-square"></i></button>
                    <form asp-action="Delete"
                          asp-route-id="@item.Id"
                          method="post"
                          class="d-inline">

                        <button type="submit"
                                class="btn btn-sm btn-outline-danger"
                                title="Delete"
                                onclick="return confirm('Are you sure you want to delete this tag?');">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Income pagination">
        <ul class="pagination justify-content-center">
            @if (Model.PageNumber > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="#" data-page="@(Model.PageNumber - 1)">Previous</a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="#" data-page="@i">@i</a>
                </li>
            }

            @if (Model.PageNumber < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="#" data-page="@(Model.PageNumber + 1)">Next</a>
                </li>
            }
        </ul>
    </nav>
}