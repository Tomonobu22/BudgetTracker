@using BudgetTracker.Core.DTOs;
@using BudgetTracker.Core.Enums;
@model TagDto

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3 row align-items-center">
        <label class="col-sm-3 col-form-label text-end pe-3"><strong>Name:</strong></label>
        <div class="col-sm-9">
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3 row align-items-center">
        @{
            var contexts = new SelectList(new List<RecordType> { RecordType.Income, RecordType.Expense, RecordType.Investment });
        }
        <label class="col-sm-3 col-form-label text-end pe-3"><strong>Context:</strong></label>
        <div class="col-sm-9">
            <select asp-for="Context" class="form-control" asp-items="@contexts"></select>
            <span asp-validation-for="Context" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3 d-flex justify-content-end">
        <button type="submit" class="btn btn-primary me-2">Add</button>
        <a asp-action="Index" class="btn btn-secondary me-2">Cancel</a>
    </div>
</form>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
