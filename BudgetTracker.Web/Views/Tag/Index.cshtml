@using BudgetTracker.Core.DTOs;
@model PagedResultDto<TagDto>

@{
    ViewData["Title"] = "Tags";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTagModal">Add New Tag</button>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Tag Context</label>
                <select id="context" class="form-select">
                    <option value="Empty">All</option>
                    <option value="Income">Income</option>
                    <option value="Expense">Expense</option>
                    <option value="Investment">Investment</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Tag Name</label>
                <input type="text" id="tagName" class="form-control" placeholder="Enter tag name" />
            </div>

            <div class="col-md-2 d-flex justify-content-end">
                <button id="filterBtn" class="btn btn-primary me-2">
                    <i class="bi bi-search"></i> Filter
                </button>
                <button id="clearBtn" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-clockwise"></i> Clear
                </button>
            </div>
        </div>
    </div>
</div>

<div id="tagTableContainer">
    @await Html.PartialAsync("_TagTablePartial", Model)
</div>

<div class="modal fade" id="createTagModal" tabindex="-1" aria-labelledby="addTagModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addTagModalLabel">Add New Tag</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <partial name="_CreateModal" model="new BudgetTracker.Core.DTOs.TagDto()" />
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">Edit Tag</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="editTagContainer">
                    Loading...
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show position-fixed bottom-0 end-0 m-3" role="alert" style="z-index: 1050;">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Success"] is string success)
{
    <div id="success-alert" class="alert alert-success alert-dismissible fade show position-fixed bottom-0 end-0 m-3" role="alert" style="z-index: 1050;">
        @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@section Scripts {
    <script>

        // Remove the success alert 
        setTimeout(function () {
            var successAlert = document.getElementById('success-alert');
            if (successAlert) {
                successAlert.classList.remove('show');
                successAlert.classList.add('fade');
                setTimeout(function () {
                    successAlert.remove();
                }, 500); // Wait for the fade-out transition to complete before removing
            }
        }, 2000);

        // Function to load filtered data via AJAX
        function loadFilteredData(page) {
               var context = $('#context').val();
               var tagName = $('#tagName').val();

               $.ajax({
                   url: '@Url.Action("Filter")',
                   type: 'GET',
                   data: { context: context, tagName: tagName, page: page },
                   success: function (result) {
                       $('#tagTableContainer').html(result);
                   },
                   error: function () {
                       alert('Error loading data.');
                   }
               });
           }

        // Handle pagination click
        $("#tagTableContainer").on('click', '.page-link', function (e) {
            e.preventDefault();
            var page = $(this).data('page');
            if (!page) return;
            loadFilteredData(page);
        });

        // Trigger filter
        $('#filterBtn').on('click', function (e) {
            e.preventDefault();
            loadFilteredData(1);
        });

        // Clear filters
        $('#clearBtn').on('click', function (e) {
            e.preventDefault();
            $('#context').val('Empty');
            $('#tagName').val('');
            loadFilteredData(1);
        });

        // Load edit form in modal
        $('#editModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var tagId = button.data('id');
            var container = $('#editTagContainer');
            container.html('Loading...');

            $.ajax({
                url: '@Url.Action("EditModal", "Tag")',
                type: 'GET',
                data: { id: tagId },
                success: function (result) {
                    container.html(result);
                },
                error: function () {
                    container.html('Error loading form.');
                }
            });
        });
    </script>
}